# Copy to .env and replace this password. Do not publish .env.
POOLSIDE_PASSWORD=CHANGE_ME
# Default: access through SSH tunnel; do not port-forward either service.
BIND_ADDRESS=127.0.0.1
# Prefer the stable /dev/serial/by-id/... device path after connecting the adapter.
RS485_DEVICE=/dev/ttyUSB0

# Enable only after live panel, wiring and Filter_Pump/Spa circuit verification.
POOL_CONTROL_ENABLED=false
